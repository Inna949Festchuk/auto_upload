# === Обязательное ===
# Client ID OAuth-приложения Яндекса (https://oauth.yandex.ru/ → «Создать OAuth-приложение»).
# Используется только для ссылки авторизации в UI. Client Secret при implicit-флоу НЕ нужен.
YANDEX_CLIENT_ID=your-client-id-here

# === Необязательные (есть значения по умолчанию) ===
# Папка на сервере (внутри контейнера), доступная для выбора в приложении.
# Смонтирована в контейнер как ./data.
DOWNLOAD_ROOT=/data

# Сколько файлов скачивать параллельно (concurrency celery-воркера).
DOWNLOAD_CONCURRENCY=8

# Лимит запросов к API Яндекс Диска, запросов/сек (общий для всех воркеров).
API_QPS=4

# Хост без IPv6-маршрута: принудить резолвер к IPv4 (1) / выключить (0).
FORCE_IPV4=1

# Секрет Django (для локального использования значение по умолчанию допустимо).
# SECRET_KEY=change-me-in-production
